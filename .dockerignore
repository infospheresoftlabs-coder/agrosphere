# Keep the build context small and avoid shipping local state or secrets.
.git
.gitignore
.agent_tmp
workspace
.venv
venv
__pycache__
*.py[cod]
*.egg-info

# Never bake local databases, dev secrets or logs into an image.
*.db
*.sqlite3
.dev-secret
*.log

# Docs and tests are not needed at runtime.
README.md
docs
scripts/e2e_test.py

.DS_Store
node_modules
